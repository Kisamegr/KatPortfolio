---
import { getEntry } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro';
const page = (await getEntry('pages', 'about'))!; const about = page.data.about!;
const base = import.meta.env.BASE_URL;
const portraitSrc = `${base}${about.portrait.src.slice(1)}`;
---
<BaseLayout title="About — Katerina" description={about.intro}><section class="shell page-intro about-grid"><div class="hero-image"><img src={portraitSrc} alt={about.portrait.alt} /></div><div><span class="eyebrow">About me</span><h1>Structure with a human centre.</h1><p class="lede">{about.intro}</p><div class="prose"><p>I care about the small details that make collaboration easier: a clear plan, room for different perspectives and the confidence to keep moving when things change.</p><p>Whether I’m coordinating a project, facilitating a workshop or helping a team make sense of research, I create conditions for people to contribute their best work.</p></div></div></section><section class="shell section about-details"><div><span class="eyebrow">What I bring</span><h2>Values in practice</h2><ul class="expertise">{about.expertise.map((item) => <li>{item}</li>)}</ul></div><div><span class="eyebrow">Tools</span><h2>Working toolkit</h2><p>Trello, Jira, Miro, Figma, Canva, Blender, Unity, Microsoft Office and Google Workspace.</p></div></section><section class="shell photo-story" aria-label="Life beyond work"><img src={`${base}portfolio-assets/about/about-photo-2956.jpg`} alt="A moment from Katerina’s life beyond work" /><div><span class="eyebrow">Beyond work</span><h2>I organise gatherings, plan trips, explore Swedish heritage, volunteer at the Stockholm Film Festival and bake whenever I can.</h2></div></section></BaseLayout>
