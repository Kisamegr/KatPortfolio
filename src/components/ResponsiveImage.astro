---
interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  decorative?: boolean;
}

import dimensions from '../image-dimensions.json';

const { src, alt, class: className, sizes = '100vw', loading = 'lazy', priority = false, decorative = false } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const source = src.replace(/^\//, '');
const target = source.replace(/\.(jpe?g|png)$/i, '');
const optimized = (width: number, format: 'avif' | 'webp') => `${base}optimized/${target}-${width}.${format}`;
const intrinsic = dimensions[src as keyof typeof dimensions] ?? { width: 1280, height: 960 };
---
<picture>
  <source type="image/avif" srcset={`${optimized(640, 'avif')} 640w, ${optimized(1280, 'avif')} 1280w, ${optimized(1920, 'avif')} 1920w`} sizes={sizes} />
  <source type="image/webp" srcset={`${optimized(640, 'webp')} 640w, ${optimized(1280, 'webp')} 1280w, ${optimized(1920, 'webp')} 1920w`} sizes={sizes} />
  <img class={className} src={optimized(1280, 'webp')} data-full-src={optimized(1920, 'webp')} sizes={sizes} width={intrinsic.width} height={intrinsic.height} alt={decorative ? '' : alt} loading={loading} decoding="async" fetchpriority={priority ? 'high' : 'auto'} />
</picture>
