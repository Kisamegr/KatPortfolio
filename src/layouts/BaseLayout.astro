---
import { getEntry } from 'astro:content';
import '../styles/global.css';
const { title, description, image, noindex = false } = Astro.props;
const site = (await getEntry('settings', 'site'))!;
const navigation = (await getEntry('pages', 'navigation'))!;
const canonical = new URL(Astro.url.pathname, Astro.site);
const sharingImage = image ?? site.data.defaultSharingImage;
const navItems = navigation.data.navigation!.items;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? site.data.defaultDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? site.data.defaultDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(sharingImage.src.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <header class="shell site-header"><a class="brand" href={base}>{site.data.name}</a><nav class="nav" aria-label="Main navigation">{navItems.map((item) => <a href={`${base}${item.href.slice(1)}`} aria-current={Astro.url.pathname.endsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav></header>
    <main><slot /></main>
    <footer class="shell footer"><span>© {new Date().getFullYear()} {site.data.name}</span><a href={`mailto:${site.data.email}`}>{site.data.email}</a></footer>
  </body>
</html>
