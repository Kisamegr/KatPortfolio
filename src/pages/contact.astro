---
import { getEntry } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro';
const page = (await getEntry('pages', 'contact'))!;
const site = (await getEntry('settings', 'site'))!;
const contact = page.data.contact!;
---
<BaseLayout title="Connect — Katerina" description={contact.intro}>
  <section class="shell contact">
    <span class="eyebrow">{contact.intro}</span>
    <h1>{contact.heading}</h1>
    <a class="email" href={`mailto:${site.data.email}`}>Email me</a>
    <a class="phone" href={`tel:${site.data.phone.dial}`}>{site.data.phone.display}</a>
    <div class="nav">
      {site.data.socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="sr-only"> (opens in a new tab)</span></a>)}
    </div>
  </section>
</BaseLayout>
