---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() { const projects = await getCollection('projects'); return projects.map((project) => ({ params: { slug: project.id.replace(/\.md$/, '') }, props: { project } })); }
const { project } = Astro.props; const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
const coverSrc = project.data.cover ? `${base}${project.data.cover.src.slice(1)}` : undefined;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = projects.findIndex((entry) => entry.id === project.id);
const previousProject = currentIndex > 0 ? projects[currentIndex - 1] : undefined;
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : undefined;
---
<BaseLayout title={`${project.data.title} — Katerina`} description={project.data.summary} image={project.data.cover}><article><section class="shell project-hero"><span class="eyebrow">{project.data.client} · {project.data.year}</span><h1>{project.data.title}</h1><p class="lede">{project.data.summary}</p></section>{project.data.cover && coverSrc && <div class="shell project-cover"><img src={coverSrc} alt={project.data.cover.alt} /></div>}<div class="shell project-body"><dl class="meta"><div><dt>Role</dt><dd>{project.data.role}</dd></div><div><dt>Focus</dt><dd>{project.data.services.join(' · ')}</dd></div><div><dt>Year</dt><dd>{project.data.year}</dd></div></dl><div class="prose"><Content /></div>{project.data.gallery.length > 0 && <div class="gallery">{project.data.gallery.map((image) => <figure><img src={`${base}${image.src.slice(1)}`} alt={image.alt} loading="lazy" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div>}<nav class="project-navigation" aria-label="Project navigation">{previousProject && <a class="text-link" href={`${base}work/${previousProject.id}/`}>Previous Project <span aria-hidden="true">↖</span></a>}{nextProject && <a class="text-link" href={`${base}work/${nextProject.id}/`}>Next Project <span aria-hidden="true">↗</span></a>}</nav></div></article></BaseLayout>
