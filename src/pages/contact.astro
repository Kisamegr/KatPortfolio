---
import { getEntry } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro';
const page = (await getEntry('pages', 'contact'))!; const site = (await getEntry('settings', 'site'))!; const contact = page.data.contact!;
---
<BaseLayout title="Contact — Kat Andersson" description={contact.intro}><section class="shell contact"><span class="eyebrow">Contact</span><h1>{contact.heading}</h1><p>{contact.intro}</p><a class="email" href={`mailto:${site.data.email}`}>{site.data.email}</a><div class="nav" style="margin-top: 2rem">{site.data.socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="sr-only"> (opens in a new tab)</span></a>)}</div></section></BaseLayout>
