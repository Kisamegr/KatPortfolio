---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';

const page = (await getEntry('pages', 'about'))!;
const about = page.data.about!;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const imageBase = '/portfolio-assets/figma-source/about/';
const stories = [
  { title: 'Organizing events', images: ['about-photo-2956.jpg', 'about-photo-2941-1.jpg'], copy: 'I enjoy bringing people together through well-structured, thoughtful experiences. I co-organised a Friendsgiving event with a classmate, where I was responsible for coordination and decoration. The event brought together people from different backgrounds, each contributing traditional dishes and sharing them in a relaxed, welcoming setting. It was rewarding to see how good planning and care can turn a simple idea into a meaningful shared moment.' },
  { title: 'Organising trips and exploring Swedish heritage', images: ['about-photo-4314.jpg'], copy: 'I often organise small trips with friends to explore Sweden’s cultural and natural heritage. Experiencing the country you live in helps build a deeper sense of belonging and openness toward different cultures. Recently, we visited the Ekeby Oak (Ekebyhovseken) in Ekerö — the largest living deciduous tree in Sweden, estimated to be around 500 years old. Standing alone yet enduring, it was a powerful reminder of resilience, presence, and the impact of carving your own path — values I carry both personally and professionally.' },
  { title: 'Volunteering', images: ['about-photo-2943.jpg'], copy: 'Volunteering is an important part of how I engage with my community. Most recently, I volunteered with the Event Field Team during the Stockholm Film Festival. I supported general event operations, assisted guests, and helped ensure activities ran smoothly in a fast-paced environment. The experience strengthened my ability to stay organised, adaptable, and calm under pressure.' },
  { title: 'Baking', images: ['about-photo-883.jpg', 'about-photo-1092.jpg'], copy: 'Baking is a creative outlet for me. I enjoy experimenting with new recipes and developing my own, paying attention to both flavour and presentation. It’s a process that rewards patience, precision, and creativity — qualities I value in all areas of my work.' }
];
---
<BaseLayout title="About — Katerina" description={about.intro}>
  <section class="shell about-hero">
    <div class="about-hero-copy"><span class="eyebrow">Project coordinator · Stockholm</span><h1 class="about-page-title">About me</h1><p class="lede">{about.intro}</p><div class="about-actions"><a class="button" href={`${base}work/`}>View my work</a><a class="text-link" href={`${base}contact/`}>Say hello <span aria-hidden="true">↗</span></a></div></div>
    <figure class="about-portrait"><ResponsiveImage src={about.portrait.src} alt={about.portrait.alt} loading="eager" priority sizes="(min-width: 821px) 42vw, 100vw" /><figcaption>Project Coordinator · Stockholm</figcaption></figure>
  </section>
  <section class="shell about-intro-section">
    <div class="about-section-heading"><span class="eyebrow">How I work</span><h2>Clear structure. Human collaboration. Thoughtful delivery.</h2></div>
    <div class="about-pillars"><article><span>01</span><h3>Bring clarity</h3><p>I turn moving parts, loose ideas, and competing priorities into an understandable path forward.</p></article><article><span>02</span><h3>Keep people connected</h3><p>I create the space for teams to communicate openly, align early, and make confident decisions.</p></article><article><span>03</span><h3>Move work forward</h3><p>I keep a calm eye on the details so creative teams can stay focused on the work that matters.</p></article></div>
  </section>
  <section class="shell about-practice">
    <div><span class="eyebrow">What I bring</span><h2>A reliable partner from first idea to final detail.</h2><p>I’m most at home in projects where people, creativity, and practical delivery need to work together.</p></div>
    <div class="about-practice-lists"><article><h3>Strengths</h3><ul class="expertise">{about.expertise.map((item) => <li>{item}</li>)}</ul></article><article><h3>Tools</h3><ul class="card-list"><li>Planning & collaboration: Trello, Jira, Miro, Figma</li><li>Design & creation: Canva, Figma, Blender, Unity</li><li>Organisation: Microsoft Office, Google Workspace</li></ul></article></div>
  </section>
  <section class="shell section about-beyond" id="beyond-work">
    <div class="about-section-heading"><span class="eyebrow">Outside the studio</span><h2 class="about-page-title">A little beyond work.</h2></div>
    <div class="about-stories">{stories.map((story, index) => <article class="about-story"><div class="story-visuals">{story.images.map((image) => <figure><ResponsiveImage src={`${imageBase}${image}`} alt={story.title} sizes="(min-width: 821px) 46vw, 100vw" /></figure>)}</div><div><span class="story-number">0{index + 1}</span><h3>{story.title}</h3><p>{story.copy}</p></div></article>)}</div>
  </section>
</BaseLayout>
