---
import { getEntry } from 'astro:content';

const navigation = (await getEntry('pages', 'navigation'))!;
const site = (await getEntry('settings', 'site'))!;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const isCurrent = (href: string) => href === '/' ? Astro.url.pathname === base : Astro.url.pathname.startsWith(`${base}${href.slice(1)}`);
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label={`${site.data.name}, home`}>
      <img class="brand-logo" src={`${base}portfolio-assets/brand/katerina-flower-logo.png`} alt="" />
      <span>{site.data.name}</span>
    </a>
    <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">Menu <span aria-hidden="true">+</span></button>
    <nav class="nav" id="primary-navigation" aria-label="Main navigation" data-navigation>
      {navigation.data.navigation!.items.map((item) => <a href={`${base}${item.href.slice(1)}`} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = document.querySelector<HTMLElement>('[data-navigation]');
  const links = navigation ? [...navigation.querySelectorAll<HTMLAnchorElement>('a')] : [];
  let lastFocused: Element | null = null;

  const close = (restoreFocus = false) => {
    if (!toggle || !navigation) return;
    toggle.setAttribute('aria-expanded', 'false');
    navigation.classList.remove('is-open');
    document.body.classList.remove('menu-open');
    if (restoreFocus && lastFocused instanceof HTMLElement) lastFocused.focus();
  };
  toggle?.addEventListener('click', () => {
    if (!navigation) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) close();
    else {
      lastFocused = document.activeElement;
      toggle.setAttribute('aria-expanded', 'true');
      navigation.classList.add('is-open');
      document.body.classList.add('menu-open');
      links[0]?.focus();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && navigation?.classList.contains('is-open')) close(true);
  });
  links.forEach((link) => link.addEventListener('click', () => close()));
</script>
