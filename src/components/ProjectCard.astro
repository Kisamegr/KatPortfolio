---
import { projectPath } from '../utils/project';

const { project } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const imageSrc = `${base}${project.data.cover.src.slice(1)}`;
---
<a class="project-card" href={`${base}${projectPath(project).slice(1)}`}>
  <img src={imageSrc} alt={project.data.cover.alt} loading="lazy" />
  <span class="eyebrow">{project.data.client} · {project.data.year}</span>
  <h3>{project.data.title}</h3>
  <p>{project.data.summary}</p><span class="card-link">Read case study <span aria-hidden="true">↗</span></span>
</a>
