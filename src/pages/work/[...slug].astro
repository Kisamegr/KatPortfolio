---
import { getCollection, render } from 'astro:content'; import { Image } from 'astro:assets'; import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() { const projects = await getCollection('projects'); return projects.map((project) => ({ params: { slug: project.id.replace(/\.md$/, '') }, props: { project } })); }
const { project } = Astro.props; const { Content } = await render(project);
---
<BaseLayout title={`${project.data.title} — Kat Andersson`} description={project.data.summary} image={project.data.cover}><article class="shell page-intro"><span class="eyebrow">{project.data.client} · {project.data.year}</span><h1>{project.data.title}</h1><p>{project.data.summary}</p>{project.data.externalUrl && <p><a class="button" href={project.data.externalUrl} target="_blank" rel="noopener noreferrer">Visit project <span class="sr-only">(opens in a new tab)</span></a></p>}<Image src={project.data.cover.src} alt={project.data.cover.alt} widths={[760, 1120, 1600]} sizes="(max-width: 1120px) 100vw, 1120px" /><dl class="meta"><div><dt>Client</dt><dd>{project.data.client}</dd></div><div><dt>Role</dt><dd>{project.data.role}</dd></div><div><dt>Services</dt><dd>{project.data.services.join(', ')}</dd></div></dl><div class="prose"><Content /></div>{project.data.gallery.length > 0 && <div class="gallery">{project.data.gallery.map((image) => <figure><Image src={image.src} alt={image.alt} widths={[500, 800]} sizes="(max-width: 700px) 100vw, 50vw" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div>}</article></BaseLayout>
