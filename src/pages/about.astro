---
import { getEntry } from 'astro:content'; import { Image } from 'astro:assets'; import BaseLayout from '../layouts/BaseLayout.astro';
const page = (await getEntry('pages', 'about'))!; const about = page.data.about!;
---
<BaseLayout title="About — Kat Andersson" description={about.intro}><section class="shell page-intro about-grid"><div class="portrait"><Image src={about.portrait.src} alt={about.portrait.alt} widths={[520, 800]} sizes="(max-width: 700px) 240px, 35vw" /></div><div><span class="eyebrow">About</span><h1>Good work starts with attention.</h1><p>{about.intro}</p><div class="prose"><p>I work with teams who care about the details and the bigger picture. My practice sits between strategy, identity, and product design — a sweet spot for finding the shape of an idea and making it feel inevitable.</p><p>Every collaboration is different, but the intention stays the same: create something clear, useful, and unmistakably human.</p></div><h2>Expertise</h2><ul class="expertise">{about.expertise.map((item) => <li>{item}</li>)}</ul></div></section></BaseLayout>
