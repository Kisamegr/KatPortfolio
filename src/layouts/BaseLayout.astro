---
import { getEntry } from 'astro:content';
import '../styles/global.css';
const { title, description, image, noindex = false } = Astro.props;
const site = (await getEntry('settings', 'site'))!;
const navigation = (await getEntry('pages', 'navigation'))!;
const canonical = new URL(Astro.url.pathname, Astro.site);
const sharingImage = image ?? site.data.defaultSharingImage;
const navItems = navigation.data.navigation!.items;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const isCurrentNavItem = (href: string) => href === '/' ? Astro.url.pathname === base : Astro.url.pathname.startsWith(`${base}${href.slice(1)}`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#1d2538" />
    <meta name="description" content={description ?? site.data.defaultDescription} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? site.data.defaultDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}${sharingImage.src.slice(1)}`, Astro.site)} />
    <meta property="og:image:alt" content={sharingImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? site.data.defaultDescription} />
    <meta name="twitter:image" content={new URL(`${base}${sharingImage.src.slice(1)}`, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="shell site-header"><a class="brand" href={base}><img class="brand-logo" src={`${base}portfolio-assets/brand/katerina-flower-logo.png`} alt="" aria-hidden="true" /><span>{site.data.name}</span></a><nav class="nav" aria-label="Main navigation">{navItems.map((item) => <a href={`${base}${item.href.slice(1)}`} aria-current={isCurrentNavItem(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav></header>
    <main id="main-content"><slot /></main>
    <section class="footer-cta"><div class="shell"><span class="eyebrow">Available for opportunities</span><h2>Reach out if you want to build structure that helps creative work move forward.</h2><a class="button" href={`${base}contact/`}>Let’s talk</a></div></section>
    <footer class="shell footer"><span class="brand"><img class="brand-logo" src={`${base}portfolio-assets/brand/katerina-flower-logo.png`} alt="" aria-hidden="true" /><span>{site.data.name}</span></span><div><a href={`mailto:${site.data.email}`}>Email me</a><a href={`tel:${site.data.phone.dial}`}>{site.data.phone.display}</a>{site.data.socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div></footer>
  </body>
</html>
