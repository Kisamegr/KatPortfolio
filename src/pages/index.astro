---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
const site = (await getEntry('settings', 'site'))!; const page = (await getEntry('pages', 'home'))!; const home = page.data.home!;
const latestProjectIds = ['faros', 'all-in', 'grocery-navigator'];
const projectId = (project: { id: string }) => project.id.replace(/\.md$/, '');
const latestProjects = (await getCollection('projects'))
  .filter((project) => latestProjectIds.includes(projectId(project)))
  .sort((a, b) => latestProjectIds.indexOf(projectId(a)) - latestProjectIds.indexOf(projectId(b)));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const roles = ['✦ Producer', '✦ Project Coordination', '✦ Facilitation', '✦ QA & Testing', '✦ Research & Insights', '✦ Team Alignment', '✦ Creative Operations', '✦ Project Delivery'];
---
<BaseLayout title={`${site.data.name} — ${site.data.role}`} description={site.data.defaultDescription}>
  <section class="shell hero"><div class="hero-copy"><h1 class="hero-heading">Hey, I’m Katerina, a project coordinator based in Stockholm.</h1><p class="hero-statement">{home.intro}</p><div class="hero-actions"><a class="button" href={`${base}${home.primaryCta.href.slice(1)}`}>{home.primaryCta.label}</a><a class="text-link" href={`${base}${home.secondaryCta.href.slice(1)}`}>{home.secondaryCta.label} <span aria-hidden="true">↗</span></a></div></div><div class="hero-image hero-flower-image"><ResponsiveImage class="hero-image-colour" src={home.hoverPortrait?.src ?? home.portrait.src} alt="" decorative loading="eager" priority sizes="(min-width: 821px) 48vw, 100vw" /><ResponsiveImage class="hero-image-mono" src={home.portrait.src} alt={home.portrait.alt} loading="eager" priority sizes="(min-width: 821px) 48vw, 100vw" /></div></section>
  <section class="role-strip" aria-label="Areas of expertise"><div class="shell">{roles.map((role) => <span>{role}</span>)}</div></section>
  <section class="section work-section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">Selected work</span><h2>{home.featuredHeading}</h2></div><a class="text-link" href={`${base}work/`}>All work <span aria-hidden="true">↗</span></a></div><div class="project-grid home-project-grid">{latestProjects.map((project) => <ProjectCard {project} />)}</div></div></section>
</BaseLayout>
