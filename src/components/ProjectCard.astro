---
const { project } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const slug = project.id.replace(/\.md$/, '');
const imageSrc = project.data.cover ? `${base}${project.data.cover.src.slice(1)}` : undefined;
---
<a class="project-card" href={`${base}work/${slug}/`}>
  {project.data.cover && imageSrc ? <img src={imageSrc} alt={project.data.cover.alt} loading="lazy" /> : <div class="project-placeholder" aria-hidden="true">Action<br />Society</div>}
  <span class="eyebrow">{project.data.client} · {project.data.year}</span>
  <h3>{project.data.title}</h3>
  <p>{project.data.summary}</p><span class="card-link">Read case study <span aria-hidden="true">↗</span></span>
</a>
