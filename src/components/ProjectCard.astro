---
import { Image } from 'astro:assets';
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const slug = project.id.replace(/\.md$/, '');
---
<a class="project-card" href={`${base}work/${slug}/`}>
  <Image src={project.data.cover.src} alt={project.data.cover.alt} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 50vw" />
  <span class="eyebrow">{project.data.client} · {project.data.year}</span>
  <h3>{project.data.title}</h3>
  <p>{project.data.summary}</p>
</a>
